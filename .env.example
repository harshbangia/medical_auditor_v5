# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# LLM provider: gemini (default) | openai (rollback / A-B)
LLM_PROVIDER=gemini

# Google Gemini (production target)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional alias also accepted: GOOGLE_API_KEY=

# OpenAI (optional — required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-key-here

# Models — defaults are provider-aware in code if you leave these blank.
# For Gemini (2.5 family is blocked for new API keys):
AUDIT_MODEL=gemini-3.1-pro-preview
VISION_MODEL=gemini-3.6-flash
VISION_OCR_MODEL=gemini-3.1-pro-preview
EXTRACT_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# For OpenAI rollback, use e.g.:
# AUDIT_MODEL=gpt-4o
# VISION_MODEL=gpt-4o-mini
# VISION_OCR_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-rds-host.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=medical_db
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Keep OCR_WORKERS low on small EC2 (2 is safe; 4 can OOM with multiple PDFs)
OCR_WORKERS=2
MAX_OCR_PAGES=30
PDF_DPI=150
MAX_VISION_IMAGES=12
VISION_BATCH_SIZE=3

# Vision-based transcription of handwritten / scanned pages that Tesseract
# cannot read (doctor's notes, prescriptions, receipts, ID cards, etc.).
# The transcribed text is folded back into the case for the audit pipeline.
VISION_OCR_ENABLED=1
MAX_VISION_OCR_PAGES=25
VISION_OCR_DPI=220
VISION_OCR_MIN_NATIVE_CHARS=120

# Auditor shown on Expert Opinion PDF (override via env if needed)
AUDITOR_NAME=DR. D.V. Saharan
AUDITOR_QUALIFICATION=MD (AIIMS)
AUDITOR_ROLE=Advisor

# Follow-up Ask sessions (case text for Q&A). Default 7 days.
QA_SESSION_TTL_HOURS=168
QA_SESSION_MAX_DISK=500
