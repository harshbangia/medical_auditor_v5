# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-proj-your-key-here

DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-rds-host.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=medical_db

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Keep OCR_WORKERS low on small EC2 (2 is safe; 4 can OOM with multiple PDFs)
OCR_WORKERS=2
MAX_OCR_PAGES=30
PDF_DPI=150
MAX_VISION_IMAGES=12
VISION_BATCH_SIZE=3
VISION_MODEL=gpt-4o-mini
AUDIT_MODEL=gpt-4o

# Vision-based transcription of handwritten / scanned pages that Tesseract
# cannot read (doctor's notes, prescriptions, receipts, ID cards, etc.).
# The transcribed text is folded back into the case for the audit pipeline.
# gpt-4o is the right default for handwriting; mini is too weak for cursive
# medical script. Cost: ~$0.30 per audit case at the 15-page cap.
VISION_OCR_ENABLED=1
VISION_OCR_MODEL=gpt-4o
MAX_VISION_OCR_PAGES=15
VISION_OCR_DPI=220
VISION_OCR_MIN_NATIVE_CHARS=120
